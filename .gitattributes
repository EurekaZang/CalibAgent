# Protocol/config/source text is hash-bound and must have identical LF bytes on
# developer machines, robots, CI, and frozen releases.
*.md text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.patch text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Preserve the source byte stream and avoid line-ending normalization of this
# already-collected hash-bound real-robot CSV. The later rule overrides *.csv.
evidence/p1_real/raw_trials.csv binary -eol

# Preserve the official IEEE conference class exactly as distributed (CRLF).
paper/ieeeconf.cls binary -eol

# Raw real-robot artifacts are retained byte-for-byte through Git LFS. Textual
# manifests, traces, and metrics remain regular Git objects for reviewability.
evidence/real_robot_snapshot_20260822/** binary -eol
evidence/real_robot_snapshot_20260822/**/*.db3 filter=lfs diff=lfs merge=lfs -text
evidence/real_robot_snapshot_20260822/localization_workspace/src/FAST_LIO/PCD/scans.pcd filter=lfs diff=lfs merge=lfs -text
evidence/real_robot_snapshot_20260822/**/*.pth filter=lfs diff=lfs merge=lfs -text
